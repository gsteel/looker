{
    "config": {
        "platform": {
            "php": "8.3.99"
        },
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "require": {
        "php": "~8.3 || ~8.4 || ~8.5"
    },
    "require-dev": {
        "psalm/plugin-phpunit": "^0.19.5",
        "roave/infection-static-analysis-plugin": "^1.43",
        "vimeo/psalm": "^6.14.3"
    },
    "autoload": {
        "psr-4": {
            "Looker\\": "../../src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Looker\\Test\\": "../../test"
        }
    }
}
