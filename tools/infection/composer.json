{
    "config": {
        "platform": {
            "php": "8.4.99"
        },
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "require": {
        "php": "~8.4 || ~8.5"
    },
    "require-dev": {
        "php-standard-library/psalm-plugin": "^2.4",
        "psalm/plugin-phpunit": "^0.20.2",
        "roave/infection-static-analysis-plugin": "^1.44",
        "vimeo/psalm": "^6.16.1"
    },
    "autoload": {
        "psr-4": {
            "Looker\\": "../../src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Looker\\Test\\": "../../test"
        }
    }
}
