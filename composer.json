{
    "name": "gsteel/looker",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "George Steel",
            "email": "gsteel@gmail.com"
        }
    ],
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "infection/extension-installer": true
        },
        "platform": {
            "php": "8.3.99"
        }
    },
    "require": {
        "php": "~8.3 || ~8.4",
        "gsteel/dot": "^1.8",
        "laminas/laminas-escaper": "^2.15",
        "psr/container": "^1.1.2 || ^2.0",
        "webmozart/assert": "^1.11"
    },
    "require-dev": {
        "doctrine/coding-standard": "^13.0.1",
        "infection/infection": "^0.30.1",
        "phpunit/phpunit": "^12.2.5",
        "psalm/plugin-phpunit": "^0.19.5",
        "squizlabs/php_codesniffer": "^3.13.2",
        "vimeo/psalm": "^6.12.0"
    },
    "conflict": {
        "shish/safe": "<2.6.4",
        "sanmai/pipeline": "<6.12"
    },
    "autoload": {
        "psr-4": {
            "Looker\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Looker\\Test\\": "test"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test",
            "@check-deps"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "static-analysis": "psalm --shepherd --stats",
        "check-deps": "composer-require-checker check",
        "infection": "infection --configuration=mutants.json",
        "test": "phpunit --colors=always"
    }
}
