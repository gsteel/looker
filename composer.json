{
    "name": "gsteel/looker",
    "description": "Another PHP templating library",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "George Steel",
            "email": "gsteel@gmail.com"
        }
    ],
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.4.99"
        }
    },
    "require": {
        "php": "~8.4.0 || ~8.5.0 || ~8.6.0",
        "laminas/laminas-escaper": "^2.17",
        "php-standard-library/type": "^6.1",
        "psr/container": "^1.1.2 || ^2.0"
    },
    "require-dev": {
        "carthage-software/mago": "^1.60.2",
        "laminas/internal-tooling": "^1.3",
        "phpunit/phpunit": "^13.4.8"
    },
    "conflict": {
        "shish/safe": "<2.6.4",
        "sanmai/pipeline": "<6.12"
    },
    "autoload": {
        "psr-4": {
            "Looker\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Looker\\Test\\": "test"
        }
    }
}
